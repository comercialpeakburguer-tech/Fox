<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#66000000" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFFFF" android:padding="14dp" android:elevation="10dp">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nova chamada disponível" android:textStyle="bold" android:textSize="18sp" android:textColor="#222222" />
        <TextView android:id="@+id/tvType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#222222" />
        <TextView android:id="@+id/tvOrigin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#333333" />
        <TextView android:id="@+id/tvPickup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#333333" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/tvDestination" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#333333" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/tvEarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textStyle="bold" android:textColor="#0A7A20" />
        <TextView android:id="@+id/tvDistance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#333333" />
        <TextView android:id="@+id/tvPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#333333" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <Button android:id="@+id/btnReject" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Recusar" />
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <Button android:id="@+id/btnAccept" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Aceitar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
